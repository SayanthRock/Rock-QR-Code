    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crystalline Rock Prism Frame -->
    <path
        android:pathData="M54,18 L87,37 L87,71 L54,90 L21,71 L21,37 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="miter"
        android:fillColor="#15000000"
        android:strokeMiterLimit="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="21"
                android:startY="18"
                android:endX="87"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFA000" /> <!-- Sunfire Orange -->
                <item android:offset="0.5" android:color="#00BDD6" /> <!-- Neon Teal -->
                <item android:offset="1.0" android:color="#00E5FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner decorative mineral shard lines to give visual depth -->
    <path
        android:pathData="M54,18 L54,34 M21,71 L40,60 M87,71 L68,60"
        android:strokeColor="#AAFFFFFF"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.4"
        android:strokeLineCap="round" />

    <!-- TOP-LEFT Finder Pattern -->
    <!-- Outer Ring -->
    <path
        android:pathData="M31,31 h12 v12 h-12 z"
        android:fillColor="#00BDD6" />
    <!-- Inner cutout spacer -->
    <path
        android:pathData="M33,33 h8 v8 h-8 z"
        android:fillColor="#0F1113" />
    <!-- Center solid block -->
    <path
        android:pathData="M35,35 h4 v4 h-4 z"
