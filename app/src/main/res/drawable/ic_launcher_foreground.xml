    <!-- BOTTOM-LEFT Finder Pattern -->
    <!-- Outer Ring -->
    <path
        android:pathData="M31,65 h12 v12 h-12 z"
        android:fillColor="#FFA000" />
    <!-- Inner cutout spacer -->
    <path
        android:pathData="M33,67 h8 v8 h-8 z"
